---
import Base from "../layouts/Base.astro";
import Masthead from "../components/Masthead.astro";
import Archive from "../components/Archive.astro";
import Foot from "../components/Foot.astro";
import { ENTRIES } from "../lib/data";
import list from "../../public/data/easy-putnam.json" with { type: "json" };

// The list is Lerma's; the statements are the archive's, matched by id.
const ids = new Set(list.problems.map((p) => p.id));
const entries = ENTRIES.filter((e) => ids.has(e.id));

const avg = (entries.reduce((n, e) => n + e.difficulty, 0) / entries.length).toFixed(1);
const years = entries.map((e) => e.year);
const updated = new Date(list.updated + "T00:00:00Z").toLocaleDateString("en-US", {
  year: "numeric",
  month: "long",
  day: "numeric",
  timeZone: "UTC",
});
---

<Base
  title="Easy Putnam Problems"
  description="Miguel A. Lerma's list of unusually easy Putnam problems, 1988–2023, with the archive's statements and difficulty ratings."
>
  <Masthead
    kicker="Easy Putnam Problems"
    stats={[
      `${entries.length} problems`,
      `${Math.min(...years)}–${Math.max(...years)}`,
      `mean difficulty ${avg}`,
      `compiled by ${list.compiler}`,
    ]}
  />

  <div class="band">
    <p>{list.note}</p>
    <p class="fine">{list.provenance} List last updated {updated}.</p>
  </div>

  <Archive entries={entries} />
  <Foot />
</Base>

<style>
  .band {
    position: relative;
    z-index: 1;
    max-width: 1280px;
    margin: 0 auto;
    padding: 1.6rem 2rem 0.4rem;
  }

  .band p {
    max-width: var(--measure);
    margin: 0 0 0.7rem;
    font-size: 0.95rem;
    line-height: 1.6;
    color: var(--ink-mid);
  }

  .band .fine { font-size: 0.85rem; }
</style>
