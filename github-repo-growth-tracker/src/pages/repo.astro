            div.className = 'ai-chat-error';
            div.textContent = msg;
            chatMessages.appendChild(div);
            chatMessages.scrollTop = chatMessages.scrollHeight;
          }

          async function sendMessage(text: string) {
            if (chatBusy) return;
            chatBusy = true;
            chatSend.disabled = true;
            chatInput.value = '';

            // Hide chips after first message
            chatChips.style.display = 'none';

            // Add user message
            addMessage('user', text);
            chatHistory.push({ role: 'user', parts: [{ text }] });

            const typingEl = addTyping();

            try {
              if (!GEMINI_KEY) {
                throw new Error('Missing Gemini API key. Set PUBLIC_GEMINI_API_KEY in your .env file.');
              }

              const body = {
                system_instruction: { parts: [{ text: systemPrompt }] },
                contents: chatHistory,
                generationConfig: {
                  temperature: 0.7,
                  topP: 0.9,
                  maxOutputTokens: 2048,
                },
              };

              const resp = await fetch(GEMINI_URL, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(body),
              });

              if (!resp.ok) {
                const errData = await resp.text();
                throw new Error(`API error ${resp.status}: ${errData.slice(0, 200)}`);
              }

              // Stream SSE response
              const reader = resp.body!.getReader();
              const decoder = new TextDecoder();
              let fullText = '';
              let aiDiv: HTMLElement | null = null;
              let buffer = '';

              typingEl.remove();

              while (true) {
                const { done, value } = await reader.read();
                if (done) break;

                buffer += decoder.decode(value, { stream: true });
                const lines = buffer.split('\n');
                buffer = lines.pop() || '';

                for (const line of lines) {
                  if (!line.startsWith('data: ')) continue;
                  const jsonStr = line.slice(6).trim();
                  if (!jsonStr || jsonStr === '[DONE]') continue;

                  try {
                    const parsed = JSON.parse(jsonStr);
                    const chunk = parsed.candidates?.[0]?.content?.parts?.[0]?.text;
                    if (chunk) {
                      fullText += chunk;
                      if (!aiDiv) {
                        aiDiv = addMessage('ai', fullText);
                      } else {
                        aiDiv.innerHTML = formatMarkdown(fullText);
                      }
                      chatMessages.scrollTop = chatMessages.scrollHeight;
                    }
                  } catch { /* skip malformed JSON */ }
                }
              }

              // If no streaming happened, check if response is non-SSE JSON
              if (!fullText) {
                typingEl.remove();
                // Try parsing the entire response as regular JSON
                try {
                  buffer += decoder.decode();
                  // The whole response might be one big JSON if SSE didn't kick in
                  const allText = buffer;
                  if (allText.startsWith('data: ')) {
                    const lines2 = allText.split('\n');
                    for (const l of lines2) {
                      if (!l.startsWith('data: ')) continue;
                      const js = l.slice(6).trim();
                      if (!js || js === '[DONE]') continue;
                      try {
                        const p = JSON.parse(js);
                        const c = p.candidates?.[0]?.content?.parts?.[0]?.text;
                        if (c) fullText += c;
                      } catch {}
                    }
                  }
                  if (fullText) {
                    addMessage('ai', fullText);
                  } else {
                    showChatError('No response received from AI.');
                  }
                } catch {
                  showChatError('Failed to parse AI response.');
                }
              }

              // Add to history
              if (fullText) {
                chatHistory.push({ role: 'model', parts: [{ text: fullText }] });
              }

            } catch (err: any) {
              typingEl.remove();
              showChatError(err.message || 'Something went wrong. Please try again.');
            } finally {
              chatBusy = false;
              chatSend.disabled = chatInput.value.trim().length === 0;
            }
          }

        } catch (err: any) {
          showError(`Error loading repo data: ${err.message}`);
        }
      })();
    }

    // ── Interactive Chart.js chart ──
    import { Chart, registerables } from 'chart.js';
    Chart.register(...registerables);

    let chartInstance: Chart | null = null;
    let chartSnapshots: { collected_on: string; stars: number }[] = [];

    function getThemeColors() {
      const style = getComputedStyle(document.documentElement);
      const accent = style.getPropertyValue('--accent').trim() || '#4f8ff7';
      const green = style.getPropertyValue('--green').trim() || '#3fb950';
      const red = style.getPropertyValue('--red').trim() || '#f85149';
      const gridColor = style.getPropertyValue('--border').trim() || '#d0d7de';
      const labelColor = style.getPropertyValue('--text-tertiary').trim() || '#656d76';
      const tooltipBg = style.getPropertyValue('--bg-card').trim() || '#ffffff';
      const tooltipText = style.getPropertyValue('--text-primary').trim() || '#1f2328';
      const tooltipBorder = style.getPropertyValue('--border').trim() || '#d0d7de';
      return { accent, green, red, gridColor, labelColor, tooltipBg, tooltipText, tooltipBorder };
    }

    function parseColor(hex: string): { r: number; g: number; b: number } {
      const c = hex.replace('#', '');
      return {
        r: parseInt(c.substring(0, 2), 16),
        g: parseInt(c.substring(2, 4), 16),
        b: parseInt(c.substring(4, 6), 16),
      };
    }

    function buildLineChart(sorted: { collected_on: string; stars: number }[]) {
      const canvas = document.getElementById('star-chart') as HTMLCanvasElement;
      if (!canvas) return;

      if (chartInstance) { chartInstance.destroy(); chartInstance = null; }

      const colors = getThemeColors();
      const { r, g, b } = parseColor(colors.accent);

      const labels = sorted.map(d => d.collected_on);
      const data = sorted.map(d => d.stars);

      chartInstance = new Chart(canvas, {
        type: 'line',
        data: {
          labels,
          datasets: [{
            label: 'Stars',
            data,
            borderColor: colors.accent,
            backgroundColor: (ctx: any) => {
              const chart = ctx.chart;
              const { ctx: canvasCtx, chartArea } = chart;
              if (!chartArea) return `rgba(${r},${g},${b},0.1)`;
              const gradient = canvasCtx.createLinearGradient(0, chartArea.top, 0, chartArea.bottom);
              gradient.addColorStop(0, `rgba(${r},${g},${b},0.25)`);
              gradient.addColorStop(1, `rgba(${r},${g},${b},0.02)`);
              return gradient;
            },
            fill: true,
            tension: 0.35,
            borderWidth: 2.5,
            pointRadius: sorted.length > 30 ? 0 : 4,
            pointHoverRadius: 7,
            pointBackgroundColor: colors.accent,
            pointBorderColor: colors.accent,
            pointHoverBackgroundColor: '#fff',
            pointHoverBorderWidth: 3,
            pointHoverBorderColor: colors.accent,
          }],
        },
        options: {
          responsive: true,
          maintainAspectRatio: false,
          animation: {
            duration: 800,
            easing: 'easeOutQuart',
          },
          interaction: {
            mode: 'index',
            intersect: false,
          },
          plugins: {
            legend: { display: false },
            tooltip: {
              backgroundColor: colors.tooltipBg,
              titleColor: colors.tooltipText,
              bodyColor: colors.tooltipText,
              borderColor: colors.tooltipBorder,
              borderWidth: 1,
              cornerRadius: 8,
              padding: 12,
              displayColors: false,
              titleFont: { family: '-apple-system, BlinkMacSystemFont, sans-serif', size: 11, weight: 'normal' as const },
              bodyFont: { family: '-apple-system, BlinkMacSystemFont, sans-serif', size: 14, weight: 'bold' as const },
              callbacks: {
                title: (items: any[]) => items[0]?.label || '',
                label: (item: any) => {
                  const val = item.raw as number;
                  const idx = item.dataIndex;
                  const prevVal = idx > 0 ? (item.dataset.data[idx - 1] as number) : val;
                  const diff = val - prevVal;
                  const diffStr = diff > 0 ? ` (+${fmt.format(diff)})` : diff < 0 ? ` (${fmt.format(diff)})` : '';
                  return `${fmt.format(val)} stars${diffStr}`;
                },
              },
            },
          },
          scales: {
            x: {
              grid: { color: colors.gridColor, lineWidth: 0.5 },
              ticks: {
                color: colors.labelColor,
                font: { family: '-apple-system, BlinkMacSystemFont, sans-serif', size: 11 },
                maxRotation: 0,
                maxTicksLimit: 8,
                callback: function(val: any, index: number) {
                  const label = labels[index];
                  return label ? label.slice(5) : '';
                },
              },
              border: { display: false },
            },
            y: {
              grid: { color: colors.gridColor, lineWidth: 0.5 },
              ticks: {
                color: colors.labelColor,
                font: { family: '-apple-system, BlinkMacSystemFont, sans-serif', size: 11 },
                callback: (val: any) => fmt.format(val as number),
                maxTicksLimit: 6,
              },
              border: { display: false },
            },
          },
        },
      });
    }

    function buildBarChart(sorted: { collected_on: string; stars: number }[]) {
      const canvas = document.getElementById('star-chart') as HTMLCanvasElement;
      if (!canvas) return;

      if (chartInstance) { chartInstance.destroy(); chartInstance = null; }

      const colors = getThemeColors();

      // Compute daily deltas
      const labels: string[] = [];
      const deltas: number[] = [];
      for (let i = 1; i < sorted.length; i++) {
        labels.push(sorted[i].collected_on);
        deltas.push(sorted[i].stars - sorted[i - 1].stars);
      }

      const barColors = deltas.map(d => d >= 0 ? colors.green : colors.red);
      const hoverColors = deltas.map(d => {
        const { r, g, b } = parseColor(d >= 0 ? colors.green : colors.red);
        return `rgba(${r},${g},${b},0.7)`;
      });

      chartInstance = new Chart(canvas, {
        type: 'bar',
        data: {
          labels,
          datasets: [{
            label: 'Daily Change',
            data: deltas,
            backgroundColor: barColors,
            hoverBackgroundColor: hoverColors,
            borderRadius: 3,
            borderSkipped: false,
          }],
        },
        options: {
          responsive: true,
          maintainAspectRatio: false,
          animation: {
            duration: 600,
            easing: 'easeOutQuart',
          },
          interaction: {
            mode: 'index',
            intersect: false,
          },
          plugins: {
            legend: { display: false },
            tooltip: {
              backgroundColor: colors.tooltipBg,
              titleColor: colors.tooltipText,
              bodyColor: colors.tooltipText,
              borderColor: colors.tooltipBorder,
              borderWidth: 1,
              cornerRadius: 8,
              padding: 12,
              displayColors: false,
              titleFont: { family: '-apple-system, BlinkMacSystemFont, sans-serif', size: 11, weight: 'normal' as const },
              bodyFont: { family: '-apple-system, BlinkMacSystemFont, sans-serif', size: 14, weight: 'bold' as const },
              callbacks: {
                title: (items: any[]) => items[0]?.label || '',
                label: (item: any) => {
                  const val = item.raw as number;
                  const sign = val >= 0 ? '+' : '';
                  return `${sign}${fmt.format(val)} stars`;
                },
              },
            },
          },
          scales: {
            x: {
              grid: { display: false },
              ticks: {
                color: colors.labelColor,
                font: { family: '-apple-system, BlinkMacSystemFont, sans-serif', size: 11 },
                maxRotation: 0,
                maxTicksLimit: 8,
                callback: function(val: any, index: number) {
                  const label = labels[index];
                  return label ? label.slice(5) : '';
                },
              },
              border: { display: false },
            },
            y: {
              grid: { color: colors.gridColor, lineWidth: 0.5 },
              ticks: {
                color: colors.labelColor,
                font: { family: '-apple-system, BlinkMacSystemFont, sans-serif', size: 11 },
                callback: (val: any) => {
                  const n = val as number;
                  return n >= 0 ? '+' + fmt.format(n) : fmt.format(n);
                },
                maxTicksLimit: 6,
              },
              border: { display: false },
            },
          },
        },
      });
    }

    function initChart(data: { collected_on: string; stars: number }[]) {
      chartSnapshots = [...data].sort((a, b) => a.collected_on.localeCompare(b.collected_on));
      buildLineChart(chartSnapshots);

      // Tab switching
      const tabs = document.querySelectorAll<HTMLButtonElement>('.chart-tab');
      tabs.forEach(tab => {
        tab.addEventListener('click', () => {
          tabs.forEach(t => t.classList.remove('active'));
          tab.classList.add('active');
          const mode = tab.dataset.chart;
          if (mode === 'bar') buildBarChart(chartSnapshots);
          else buildLineChart(chartSnapshots);
        });
      });

      // Re-render on theme change
      const observer = new MutationObserver(() => {
        const activeTab = document.querySelector('.chart-tab.active') as HTMLElement;
        const mode = activeTab?.dataset?.chart || 'line';
        if (mode === 'bar') buildBarChart(chartSnapshots);
        else buildLineChart(chartSnapshots);
      });
      observer.observe(document.documentElement, { attributes: true, attributeFilter: ['data-theme'] });
    }
  </script>
</Base>
