---
import Base from '../layouts/Base.astro';
---

<Base title="Repo Signal Analysis" active="repo">
  <div id="loading" class="msg-cell" style="padding:48px 0; text-align:center; color:#8b949e;">Analyzing repo&hellip;</div>
  <div id="repo-detail" hidden>
    <!-- Header -->
    <div class="repo-header">
      <div class="repo-title-row">
        <h1 id="repo-full-name"></h1>
        <button id="watch-btn" class="watchlist-btn" style="font-size:22px;">☆</button>
        <a id="gh-link" href="#" target="_blank" rel="noreferrer" class="gh-button">View on GitHub ↗</a>
      </div>
      <p id="repo-desc" class="repo-desc"></p>
      <div id="repo-topics" class="repo-topics"></div>
      <div class="repo-meta-row" id="repo-meta-row"></div>
    </div>

    <!-- Verdict Banner -->
    <div id="verdict-banner" class="verdict-banner"></div>

    <!-- Signal Cards -->
    <div class="signal-grid" id="signal-grid"></div>

    <!-- Momentum Model Breakdown -->
    <div class="detail-table-section" id="momentum-section" hidden>
      <h2>Deal Flow Signal</h2>
      <p class="subtitle" style="margin-bottom:12px;">Open-source freemium deal flow model — ratio-based growth rate × target zone × quality filters.</p>
      <div class="signal-grid" id="momentum-grid"></div>
    </div>

    <!-- Investment Thesis -->
    <div class="thesis-section" id="thesis-section">
      <h2>Investment Thesis</h2>
      <div class="thesis-box">
        <div class="thesis-label">Why this matters</div>
        <ul class="thesis-bullets" id="thesis-list"></ul>
      </div>
    </div>

    <!-- Red Flags / Green Flags -->
    <div class="red-flags-section" id="flags-section">
      <h2>Signal Checklist</h2>
      <div class="flag-list" id="flag-list"></div>
    </div>

    <!-- Two-column: Chart + Activity -->
    <div class="two-col">
      <div class="two-col-main">
        <div class="chart-section">
          <div class="chart-header">
            <h2>Star History</h2>
            <div class="chart-tabs">
              <button class="chart-tab active" data-chart="line">Growth</button>
              <button class="chart-tab" data-chart="bar">Daily Change</button>
            </div>
          </div>
          <div class="chart-container">
            <canvas id="star-chart"></canvas>
          </div>
        </div>
      </div>
      <div class="two-col-side">
        <div class="activity-section" id="activity-section">
          <h2>Activity Signals</h2>
          <div id="activity-list" class="activity-list"></div>
        </div>
      </div>
    </div>

    <!-- Competitive Landscape -->
    <div class="detail-table-section" id="comp-section" hidden>
      <h2>Similar Repos (by topic)</h2>
      <p class="subtitle" style="margin-bottom:12px;">Other repos in the same space — see how this one stacks up.</p>
      <div class="comp-grid" id="comp-grid"></div>
    </div>

    <!-- Growth Breakdown -->
    <div class="detail-table-section">
      <h2>Growth Breakdown</h2>
      <div class="table-wrap">
        <table>
          <thead>
            <tr>
              <th style="text-align:left">Period</th>
              <th class="num">Stars gained</th>
              <th class="num">Growth rate</th>
              <th class="num">Stars/day</th>
              <th style="text-align:left">Trend</th>
            </tr>
          </thead>
          <tbody id="growth-body"></tbody>
        </table>
      </div>
    </div>

    <!-- Daily Metrics Table -->
    <div class="detail-table-section">
      <h2>Raw Snapshots</h2>
      <div class="table-wrap">
        <table>
          <thead>
            <tr>
              <th style="text-align:left">Date</th>
              <th class="num">Stars</th>
              <th class="num">Forks</th>
              <th class="num">Change</th>
            </tr>
          </thead>
          <tbody id="daily-body"></tbody>
        </table>
      </div>
    </div>

    <!-- AI Chat Panel -->
    <div class="ai-chat-panel ai-chat-collapsed" id="ai-chat-panel">
      <div class="ai-chat-header" id="ai-chat-header">
        <span class="ai-chat-header-left">
          <span class="ai-chat-icon">&#9670;</span>
          <span class="ai-chat-title">Ask AI about this repo</span>
        </span>
        <span class="ai-chat-toggle" id="ai-chat-toggle">&#9650;</span>
      </div>
      <div class="ai-chat-body" id="ai-chat-body">
        <div class="ai-chat-chips" id="ai-chat-chips">
          <button class="ai-chat-chip" data-q="Is this a good investment opportunity?">Good investment?</button>
          <button class="ai-chat-chip" data-q="What are the biggest risks with this repo?">Biggest risks?</button>
          <button class="ai-chat-chip" data-q="What does the growth trajectory look like?">Growth trajectory?</button>
          <button class="ai-chat-chip" data-q="How do the metrics compare to similar repos?">How do metrics compare?</button>
          <button class="ai-chat-chip" data-q="What would make this a strong buy signal?">What would make it a buy?</button>
        </div>
        <div class="ai-chat-messages" id="ai-chat-messages"></div>
        <div class="ai-chat-input-row">
          <input type="text" class="ai-chat-input" id="ai-chat-input" placeholder="Ask anything about this repo…" autocomplete="off" />
          <button class="ai-chat-send" id="ai-chat-send" disabled>&#9654;</button>
        </div>
      </div>
    </div>
  </div>

  <div id="error-box" class="error-box" hidden></div>

  <script>
    import { createClient } from '@supabase/supabase-js';

    const supabaseUrl = import.meta.env.PUBLIC_SUPABASE_URL;
    const supabaseAnonKey = import.meta.env.PUBLIC_SUPABASE_ANON_KEY;
    const fmt = new Intl.NumberFormat('en-US');
    const pct = (v: number) => v.toFixed(1) + '%';

    const params = new URLSearchParams(window.location.search);
    const owner = params.get('owner');
    const name = params.get('name');

    const loadingEl = document.getElementById('loading')!;
    const detailEl = document.getElementById('repo-detail')!;
    const errorEl = document.getElementById('error-box')!;

    // Watchlist helpers
    function getWatchlist(): string[] {
      try { return JSON.parse(localStorage.getItem('repo_watchlist') || '[]'); } catch { return []; }
    }
    function toggleWatch(repoKey: string) {
      const wl = getWatchlist();
      const idx = wl.indexOf(repoKey);
      if (idx >= 0) wl.splice(idx, 1); else wl.push(repoKey);
      localStorage.setItem('repo_watchlist', JSON.stringify(wl));
    }
    function isWatched(repoKey: string): boolean {
      return getWatchlist().includes(repoKey);
    }

    function showError(msg: string) {
      loadingEl.hidden = true;
      errorEl.hidden = false;
      errorEl.textContent = msg;
    }

    function delta(v: number): string {
      return v > 0 ? `+${fmt.format(v)}` : fmt.format(v);
    }
    function cls(v: number): string {
      if (v > 0) return 'positive';
      if (v < 0) return 'negative';
      return 'neutral';
    }

    if (!owner || !name) {
      showError('Missing repo owner or name.');
    } else {
      (async () => {
        try {
          // 1. Growth metrics from static JSON
          let growth: any = null;
          let allReposData: any[] = [];
          try {
            const jsonResp = await fetch('/data/repos.json');
            if (jsonResp.ok) {
              const json = await jsonResp.json();
              allReposData = json.repos || [];
              const found = allReposData.find((r: any) => r.o === owner && r.n === name);
              if (found) {
                growth = {
                  repo_owner: found.o,
                  repo_name: found.n,
                  repo_url: found.u,
                  current_stars: found.s,
                  current_forks: found.f,
                  one_day_stars: found.d1s,
                  seven_day_stars: found.d7s,
                  one_month_stars: found.d1ms,
                  three_month_stars: found.d3ms,
                  one_day_forks: found.d1f,
                  seven_day_forks: found.d7f,
                  one_month_forks: found.d1mf,
                  three_month_forks: found.d3mf,
                };
              }
            }
          } catch { /* JSON not available, will try Supabase fallback */ }

          // Fallback to Supabase if JSON didn't have the repo
          if (!growth && supabaseUrl && supabaseAnonKey) {
            const sb = createClient(supabaseUrl, supabaseAnonKey, { auth: { persistSession: false } });
            const { data: gData } = await sb
              .from('repo_growth_metrics')
              .select('*')
              .eq('repo_owner', owner)
              .eq('repo_name', name)
              .single();
            if (gData) growth = gData;
          }

          if (!growth) {
            showError(`Repo ${owner}/${name} not found in growth metrics.`);
            return;
          }

          // 2. Daily snapshots (still from Supabase — not in JSON)
          let dailySnapshots: { collected_on: string; stars: number; forks: number }[] = [];
          if (supabaseUrl && supabaseAnonKey) {
            const supabase = createClient(supabaseUrl, supabaseAnonKey, { auth: { persistSession: false } });
            const { data: tracked } = await supabase
              .from('tracked_repos')
              .select('id')
              .eq('repo_owner', owner)
              .eq('repo_name', name)
              .single();

            if (tracked) {
              const { data: daily } = await supabase
                .from('repo_daily_metrics')
                .select('collected_on, stars, forks')
                .eq('tracked_repo_id', tracked.id)
                .order('collected_on', { ascending: true });
              dailySnapshots = daily || [];
            }
          }

          // 3. GitHub API — repo info + recent activity
          let ghInfo: any = null;
          let recentCommits: any[] = [];
          let contributors: any[] = [];
          let openPRs = 0;
          let recentReleases: any[] = [];

          try {
            const ghHeaders = { 'Accept': 'application/vnd.github+json' };
            const [repoResp, commitsResp, contribResp, prResp, releasesResp] = await Promise.allSettled([
              fetch(`https://api.github.com/repos/${owner}/${name}`, { headers: ghHeaders }),
              fetch(`https://api.github.com/repos/${owner}/${name}/commits?per_page=30`, { headers: ghHeaders }),
              fetch(`https://api.github.com/repos/${owner}/${name}/contributors?per_page=10`, { headers: ghHeaders }),
              fetch(`https://api.github.com/repos/${owner}/${name}/pulls?state=open&per_page=1`, { headers: ghHeaders }),
              fetch(`https://api.github.com/repos/${owner}/${name}/releases?per_page=5`, { headers: ghHeaders }),
            ]);

            if (repoResp.status === 'fulfilled' && repoResp.value.ok)
              ghInfo = await repoResp.value.json();
            if (commitsResp.status === 'fulfilled' && commitsResp.value.ok)
              recentCommits = await commitsResp.value.json();
            if (contribResp.status === 'fulfilled' && contribResp.value.ok)
              contributors = await contribResp.value.json();
            if (prResp.status === 'fulfilled' && prResp.value.ok) {
              const prData = await prResp.value.json();
              openPRs = prData.length;
            }
            if (releasesResp.status === 'fulfilled' && releasesResp.value.ok)
              recentReleases = await releasesResp.value.json();
          } catch { /* non-critical */ }

          // ── Compute investment signals ──
          const stars = growth.current_stars;
          const forks = growth.current_forks;
          const d1 = growth.one_day_stars;
          const d7 = growth.seven_day_stars;
          const d1m = growth.one_month_stars;
          const d3m = growth.three_month_stars;

          const rate7d = stars > 0 ? (d7 / stars) * 100 : 0;
          const rate1m = stars > 0 ? (d1m / stars) * 100 : 0;
          const rate3m = stars > 0 ? (d3m / stars) * 100 : 0;

          const weeklyFrom1m = d1m > 0 ? d1m / 4.3 : 0;
          const acceleration = weeklyFrom1m > 0 ? ((d7 / weeklyFrom1m) - 1) * 100 : 0;

          const starsPerDay7d = d7 / 7;
          const starsPerDay1m = d1m / 30;
          const starsPerDay3m = d3m / 90;

          const projected6m = Math.round(stars + starsPerDay7d * 180);

          const createdAt = ghInfo?.created_at ? new Date(ghInfo.created_at) : null;
          const ageMonths = createdAt ? Math.max(1, Math.round((Date.now() - createdAt.getTime()) / (30.44 * 24 * 60 * 60 * 1000))) : null;
          const starsPerMonth = ageMonths ? Math.round(stars / ageMonths) : null;

          const lastCommitDate = recentCommits[0]?.commit?.author?.date
            ? new Date(recentCommits[0].commit.author.date) : null;
          const daysSinceCommit = lastCommitDate
            ? Math.round((Date.now() - lastCommitDate.getTime()) / (24*60*60*1000)) : null;

          const thirtyDaysAgo = new Date(Date.now() - 30 * 24 * 60 * 60 * 1000);
          const commitsLast30d = recentCommits.filter(c => {
            const d = c.commit?.author?.date;
            return d && new Date(d) >= thirtyDaysAgo;
          }).length;

          const lastRelease = recentReleases[0];
          const lastReleaseDate = lastRelease?.published_at ? new Date(lastRelease.published_at) : null;
          const daysSinceRelease = lastReleaseDate
            ? Math.round((Date.now() - lastReleaseDate.getTime()) / (24*60*60*1000)) : null;

          const forkStarRatio = stars > 0 ? (forks / stars) * 100 : 0;

          // Number of unique contributors
          const numContributors = contributors.length;

          // ── Verdict scoring ──
          type Signal = { positive: boolean; weight: number; label: string };
          const signals: Signal[] = [];

          if (rate7d > 2) signals.push({ positive: true, weight: 3, label: 'Strong weekly growth rate' });
          else if (rate7d > 0.5) signals.push({ positive: true, weight: 1, label: 'Moderate weekly growth' });
          else signals.push({ positive: false, weight: 1, label: 'Low weekly growth' });

          if (acceleration > 20) signals.push({ positive: true, weight: 3, label: 'Rapid acceleration' });
          else if (acceleration > 0) signals.push({ positive: true, weight: 1, label: 'Slight acceleration' });
          else if (acceleration < -30) signals.push({ positive: false, weight: 2, label: 'Decelerating fast' });

          if (daysSinceCommit !== null && daysSinceCommit <= 7) signals.push({ positive: true, weight: 2, label: 'Recent commits (active dev)' });
          else if (daysSinceCommit !== null && daysSinceCommit > 90) signals.push({ positive: false, weight: 3, label: 'Stale — no commits in 90+ days' });

          if (commitsLast30d >= 10) signals.push({ positive: true, weight: 2, label: 'High commit frequency' });
          else if (commitsLast30d === 0) signals.push({ positive: false, weight: 2, label: 'Zero commits this month' });

          if (ageMonths && ageMonths <= 12 && stars >= 500) signals.push({ positive: true, weight: 3, label: 'Young repo with strong traction' });
          if (ageMonths && ageMonths <= 6 && stars >= 1000) signals.push({ positive: true, weight: 3, label: 'Explosive early growth' });

          // Contributor diversity
          if (numContributors >= 5) signals.push({ positive: true, weight: 2, label: 'Multiple contributors (not solo project)' });
          else if (numContributors <= 1) signals.push({ positive: false, weight: 1, label: 'Single contributor — bus factor risk' });

          // Fork engagement
          if (forkStarRatio > 20) signals.push({ positive: true, weight: 1, label: 'High fork ratio — devs building on it' });

          const totalWeight = signals.reduce((s, x) => s + x.weight, 0);
          const positiveWeight = signals.filter(s => s.positive).reduce((s, x) => s + x.weight, 0);
          const score = totalWeight > 0 ? (positiveWeight / totalWeight) * 100 : 50;

          let verdictLevel: string;
          let verdictText: string;
          let verdictDesc: string;

          if (score >= 75) {
            verdictLevel = 'strong';
            verdictText = 'Strong breakout signal';
            verdictDesc = 'Multiple indicators of rapid, accelerating growth with active development. Worth a deep look for investment.';
          } else if (score >= 55) {
            verdictLevel = 'moderate';
            verdictText = 'Moderate growth signal';
            verdictDesc = 'Growing steadily with some positive signals. Monitor for acceleration before committing.';
          } else if (score >= 35) {
            verdictLevel = 'weak';
            verdictText = 'Weak signal';
            verdictDesc = 'Limited growth indicators. May be stable but not showing breakout potential right now.';
          } else {
            verdictLevel = 'none';
            verdictText = 'No breakout signal';
            verdictDesc = 'Not showing meaningful growth momentum. Could be dormant or fully mature.';
          }

          // ── Render everything ──
          loadingEl.hidden = true;
          detailEl.hidden = false;

          document.title = `${owner}/${name} — Signal Analysis`;

          // Header
          const fullNameEl = document.getElementById('repo-full-name')!;
          const ownerSpan = document.createElement('span');
          ownerSpan.className = 'repo-owner-part';
          ownerSpan.textContent = owner + '/';
          const nameSpan = document.createElement('span');
          nameSpan.textContent = name;
          fullNameEl.appendChild(ownerSpan);
          fullNameEl.appendChild(nameSpan);

          // Watchlist button
          const repoKey = `${owner}/${name}`;
          const watchBtn = document.getElementById('watch-btn')!;
          watchBtn.textContent = isWatched(repoKey) ? '\u2605' : '\u2606';
          watchBtn.classList.toggle('watched', isWatched(repoKey));
          watchBtn.addEventListener('click', () => {
            toggleWatch(repoKey);
            watchBtn.textContent = isWatched(repoKey) ? '\u2605' : '\u2606';
            watchBtn.classList.toggle('watched', isWatched(repoKey));
          });

          (document.getElementById('gh-link') as HTMLAnchorElement).href = `https://github.com/${owner}/${name}`;

          const descEl = document.getElementById('repo-desc')!;
          if (ghInfo?.description) descEl.textContent = ghInfo.description;
          else descEl.style.display = 'none';

          const topicsEl = document.getElementById('repo-topics')!;
          if (ghInfo?.topics?.length) {
            for (const t of ghInfo.topics.slice(0, 10)) {
              const tag = document.createElement('span');
              tag.className = 'topic-tag';
              tag.textContent = t;
              topicsEl.appendChild(tag);
            }
          }

          const metaRow = document.getElementById('repo-meta-row')!;
          const metaItems: string[] = [];
          if (ghInfo?.language) metaItems.push(ghInfo.language);
          if (ghInfo?.license?.spdx_id && ghInfo.license.spdx_id !== 'NOASSERTION')
            metaItems.push(ghInfo.license.spdx_id);
          if (ageMonths) metaItems.push(`${ageMonths} months old`);
          if (ghInfo?.open_issues_count !== undefined)
            metaItems.push(`${fmt.format(ghInfo.open_issues_count)} open issues`);
          if (numContributors > 0)
            metaItems.push(`${numContributors}+ contributors`);
          metaRow.innerHTML = metaItems
            .map(item => `<span class="repo-meta-item">${item}</span>`)
            .join('');

          // Verdict banner
          const verdictEl = document.getElementById('verdict-banner')!;
          verdictEl.className = `verdict-banner verdict-${verdictLevel}`;
          verdictEl.innerHTML = `
            <div class="verdict-score">${Math.round(score)}</div>
            <div class="verdict-text">
              <strong>${verdictText}</strong>
              <span>${verdictDesc}</span>
            </div>
          `;

          // Signal cards
          const signalGrid = document.getElementById('signal-grid')!;
          const signalCards = [
            {
              label: 'Stars',
              value: fmt.format(stars),
              sub: starsPerMonth ? `~${fmt.format(starsPerMonth)}/mo avg` : '',
            },
            {
              label: '7d Growth',
              value: delta(d7),
              sub: `${pct(rate7d)} of total`,
              cls: cls(d7),
            },
            {
              label: 'Acceleration',
              value: acceleration > 0 ? `+${pct(acceleration)}` : pct(acceleration),
              sub: acceleration > 20 ? 'Speeding up fast' : acceleration > 0 ? 'Speeding up' : acceleration < -10 ? 'Slowing down' : 'Steady',
              cls: acceleration > 10 ? 'positive' : acceleration < -10 ? 'negative' : 'neutral',
            },
            {
              label: '6mo Projection',
              value: fmt.format(projected6m),
              sub: `at ${starsPerDay7d.toFixed(0)} stars/day`,
            },
            {
              label: '1 Month',
              value: delta(d1m),
              sub: `${pct(rate1m)} • ${starsPerDay1m.toFixed(1)}/day`,
              cls: cls(d1m),
            },
            {
              label: '3 Months',
              value: delta(d3m),
              sub: `${pct(rate3m)} • ${starsPerDay3m.toFixed(1)}/day`,
              cls: cls(d3m),
            },
          ];

          for (const s of signalCards) {
            const card = document.createElement('div');
            card.className = 'stat-card';
            card.innerHTML = `
              <div class="stat-label">${s.label}</div>
              <div class="stat-value ${s.cls || ''}">${s.value}</div>
              ${s.sub ? `<div class="stat-sub">${s.sub}</div>` : ''}
            `;
            signalGrid.appendChild(card);
          }

          // ── Momentum Model Breakdown ──
          const d1f = growth.one_day_forks || 0;
          const d7f = growth.seven_day_forks || 0;
          const d1mf = growth.one_month_forks || 0;
          const d3mf = growth.three_month_forks || 0;

          // Step 1: Engagement (3x forks)
          const E_total = stars + (3 * forks);
          const E_1  = Math.max(0, d1  + (3 * d1f));
          const E_7  = Math.max(0, d7  + (3 * d7f));
          const E_30 = Math.max(0, d1m + (3 * d1mf));
          const E_90 = Math.max(0, d3m + (3 * d3mf));

          // Step 2: Ratio-based M_base — growth rate
          const M_base = (0.75 * E_7 / (E_total + 1)) + (0.25 * E_30 / (E_total + 1));

          // Step 3: Target Zone — hard cut <1k, sweet spot 1k-10k, R² >10k
          let R_zone: number;
          if (stars < 1000) R_zone = 0;
          else if (stars <= 10000) R_zone = 1.0;
          else R_zone = (10000 / stars) * (10000 / stars);

          // Step 4: Quality filters
          const H_1  = 1 - (0.4 * E_1 / (E_7 + 1));

          const weeklyRatio = E_7 / (E_30 + 1);
          const Q_s = weeklyRatio >= 0.25
            ? Math.min(1.5, 1 + (weeklyRatio - 0.25))
            : weeklyRatio / 0.25;

          const monthlyRatio = E_30 / (E_90 + 1);
          const C_90 = monthlyRatio >= 0.33
            ? Math.min(1.5, 1 + (monthlyRatio - 0.33))
            : monthlyRatio / 0.33;

          // Step 5: Final Signal
          const finalMomentum = Math.max(0, M_base * R_zone * H_1 * Q_s * C_90 * 10000);

          const momentumSection = document.getElementById('momentum-section')!;
          const momentumGrid = document.getElementById('momentum-grid')!;
          momentumSection.hidden = false;

          const fmtSignal = (v: number) => v >= 10 ? Math.round(v).toLocaleString() : v.toFixed(1);

          const momentumCards = [
            {
              label: 'M_base (Growth Rate)',
              value: (M_base * 100).toFixed(2) + '%',
              sub: '75%×7D + 25%×30D ratio',
              cls: M_base > 0.01 ? 'positive' : 'neutral',
            },
            {
              label: 'Target Zone (R)',
              value: R_zone.toFixed(3) + '×',
              sub: stars >= 1000 && stars <= 10000 ? '🎯 Sweet spot (1k–10k)' : stars < 1000 ? '⛔ Below 1k — excluded' : `Above sweet spot (R²=${R_zone.toFixed(4)})`,
              cls: R_zone >= 0.8 ? 'positive' : R_zone > 0 ? 'neutral' : 'negative',
            },
            {
              label: 'Hype Penalty (H₁)',
              value: H_1.toFixed(3) + '×',
              sub: H_1 >= 0.9 ? 'Organic growth' : H_1 >= 0.7 ? 'Slight spike' : 'Heavy 1d spike',
              cls: H_1 >= 0.8 ? 'positive' : H_1 >= 0.6 ? 'neutral' : 'negative',
            },
            {
              label: 'Steadiness (Qₛ)',
              value: Q_s.toFixed(3) + '×',
              sub: Q_s >= 1.2 ? 'Surging this week' : Q_s >= 0.9 ? 'Steady weekly' : Q_s >= 0.5 ? 'Slowing weekly' : 'Stalled weekly',
              cls: Q_s >= 1.0 ? 'positive' : Q_s >= 0.5 ? 'neutral' : 'negative',
            },
            {
              label: 'Consistency (C₉₀)',
              value: C_90.toFixed(3) + '×',
              sub: C_90 >= 1.2 ? 'Accelerating vs 3M' : C_90 >= 0.9 ? 'Steady vs 3M' : C_90 >= 0.5 ? 'Slowing vs 3M' : C_90 > 0 ? 'Decelerating' : 'No 3M data',
              cls: C_90 >= 1.0 ? 'positive' : C_90 >= 0.5 ? 'neutral' : 'negative',
            },
            {
              label: 'Final Signal',
              value: fmtSignal(finalMomentum),
              sub: finalMomentum >= 20 ? '🔥 Hot signal' : finalMomentum >= 5 ? '🟡 Warm signal' : finalMomentum > 0 ? 'Mild signal' : 'No signal',
